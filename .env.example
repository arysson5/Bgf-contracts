GOOGLE_API_KEY=sua_chave_aqui
# Modelos recomendados: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-flash-latest
# gemini-1.5-flash e gemini-2.0-flash retornam 404 para contas novas
MODEL_NAME=gemini-2.5-flash
# Modelo opcional para modo Criteriosa (classificação jurídica de hunks confirmados)
MODEL_NAME_PRO=gemini-2.5-pro
# Login padrão (altere em produção)
BGF_DEFAULT_ADMIN_EMAIL=admin@bgf.local
BGF_DEFAULT_ADMIN_PASSWORD=admin123
# Saída máxima por chamada à IA (matriz item a item usa várias chamadas; 16384+ recomendado)
# Saída da IA por chamada; proposta/contrato até 80k chars (context_limits.py)
MAX_TOKENS=32768
# Embeddings para indexar blocos de diff (mesma GOOGLE_API_KEY)
EMBEDDING_MODEL=text-embedding-004
CONTRACTS_DIR=./contracts
DB_PATH=./contract_analyzer.db
# Pasta inicial ao abrir Salvar como (opcional; padrão: Documentos do usuário)
# EXPORT_DIR=C:\Users\seu_usuario\Downloads
